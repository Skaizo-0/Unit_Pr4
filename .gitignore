*.pyc

# IDE & Editor caches
.vs/
.idea/
.gradle/
*.DotSettings.user
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.user
*.userprefs
*.tmp
*.log

# Ensure submission folders are always tracked
!L4_submit_41/
!L4_submit_41/**
!L4_submit_42/
!L4_submit_42/**
